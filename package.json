{
  "name": "sav-validator",
  "version": "0.1.0",
  "description": "Server Action Validation - runtime helpers, React bindings, and schema compiler.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler/index.d.ts",
        "default": "./dist/compiler/index.js"
      },
      "require": {
        "types": "./dist/compiler/index.d.cts",
        "default": "./dist/compiler/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "sav-validator": "./dist/compiler/cli.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "prepack": "pnpm build",
    "publint": "publint .",
    "pack:check": "npm pack --dry-run",
    "audit": "pnpm audit --prod --registry https://registry.npmjs.org",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm publint && pnpm pack:check && pnpm run audit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "valibot": "^0.30.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^12.0.0",
    "glob": "^13.0.6",
    "ts-morph": "^21.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "publint": "^0.3.18",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4",
    "react-dom": "^19.2.4",
    "valibot": "^0.30.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink01101011/sav.git"
  },
  "bugs": {
    "url": "https://github.com/Ink01101011/sav/issues"
  },
  "homepage": "https://github.com/Ink01101011/sav#readme"
}
