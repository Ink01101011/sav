{
  "name": "sav-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "Workspace for the SAV publishable packages.",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "publish:packages:dry-run": "pnpm -r --filter './packages/*' publish --dry-run --no-git-checks --access public",
    "publish:packages": "pnpm -r --filter './packages/*' publish --access public",
    "prepublishOnly": "node -e \"console.error('Root workspace must not be published. Use: pnpm publish:packages'); process.exit(1)\"",
    "publint": "pnpm -r --filter './packages/*' exec publint .",
    "pack:check": "pnpm -r --filter './packages/*' exec npm pack --dry-run",
    "audit": "pnpm audit --prod",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm publint && pnpm pack:check && pnpm audit --prod",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "turbo": "^2.8.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4",
    "react-dom": "^19.2.4"
  }
}
