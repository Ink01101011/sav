{
  "name": "sav-core",
  "version": "0.1.0",
  "description": "Runtime helpers for SAV server action validation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2022",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "valibot": "^0.30.0"
  },
  "devDependencies": {
    "valibot": "^0.30.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink01101011/sav.git"
  },
  "bugs": {
    "url": "https://github.com/Ink01101011/sav/issues"
  },
  "homepage": "https://github.com/Ink01101011/sav#readme"
}
